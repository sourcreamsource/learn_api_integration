# AI API 인증 키를 실제 값으로 바꾼 뒤, 이 파일이 아니라 .env에 보관한다.
AI_API_KEY="your-api-key"

# Claude의 Anthropic Messages 요청 형식을 사용한다.
AI_API_FORMAT=anthropic

# 빠르고 비용이 낮은 Claude Haiku 4 모델로 고정한다.
AI_MODEL=claude-haiku-4

# 실제 사용할 서버의 Anthropic Messages 전체 엔드포인트를 지정하며, 코드에는 기본 주소가 없다.
AI_API_URL="https://copa.codyssey.kr/v1/messages"
